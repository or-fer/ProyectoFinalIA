  "diagnosticos": {
    "D_AC": {
      "nombre": "Suministro AC inadecuado (toma, regleta o cable de corriente)",
      "subsistema": "Alimentación",
      "accion": "Pruebe la toma con otro aparato y vuelva a medir; cambie regleta o cable de corriente. Si el voltaje es estable y correcto, pase a revisar la fuente.",
      "seguridad": "Mida la toma con cuidado y sin tocar las puntas del multímetro."
    },
    "D_FUS": {
      "nombre": "Fusible de la fuente abierto (posible cortocircuito en la etapa primaria)",
      "subsistema": "Alimentación",
      "accion": "No sustituya el fusible por uno de mayor amperaje. Cambie la fuente completa o llévela a reparación: un fusible abierto suele indicar un cortocircuito.",
      "seguridad": "No abra la fuente: sus capacitores pueden retener carga peligrosa aunque esté desconectada."
    },
    "D_PSU": {
      "nombre": "Fuente de poder degradada o defectuosa (rieles fuera de tolerancia)",
      "subsistema": "Alimentación",
      "accion": "Confirme con un probador de fuentes o midiendo con carga; sustituya la fuente por una de potencia adecuada.",
      "seguridad": "No abra la fuente: sus capacitores pueden retener carga peligrosa aunque esté desconectada."
    },
    "D_PSU_ALTO": {
      "nombre": "Fuente con regulación defectuosa (sobretensión en algún riel)",
      "subsistema": "Alimentación",
      "accion": "Deje de usar esa fuente de inmediato y sustitúyala; revise si placa base, RAM o discos resultaron dañados.",
      "seguridad": "Una sobretensión puede dañar otros componentes: no encienda el equipo con esa fuente."
    },
    "D_QUEMADO": {
      "nombre": "Componente dañado por sobrecarga o cortocircuito",
      "subsistema": "Alimentación",
      "accion": "Desconecte el equipo, inspeccione visualmente (capacitores hinchados, zonas oscurecidas) y aísle la causa retirando componentes de uno en uno.",
      "seguridad": "Riesgo de incendio o descarga: desconecte de la corriente antes de abrir el equipo."
    },
    "D_BTN": {
      "nombre": "Botón de encendido, cable del panel frontal o placa base sin arranque",
      "subsistema": "Arranque",
      "accion": "Con el equipo desconectado, revise el conector del botón (PWR_SW) en la placa; descarte el botón puenteando brevemente esos pines con un destornillador aislado; si no arranca, sospeche de la placa base.",
      "seguridad": "Desconecte el cable de corriente antes de manipular conectores internos."
    },
    "D_RAM": {
      "nombre": "Memoria RAM mal asentada o defectuosa",
      "subsistema": "Arranque",
      "accion": "Retire y reasiente los módulos, pruébelos de uno en uno y en otra ranura; limpie los contactos con alcohol isopropílico.",
      "seguridad": "Use pulsera antiestática o toque el chasis metálico antes de manipular los módulos."
    },
    "D_GPU": {
      "nombre": "Tarjeta de video mal asentada o defectuosa",
      "subsistema": "Arranque",
      "accion": "Reasiente la tarjeta y sus conectores de alimentación PCIe; pruebe con video integrado o con otra tarjeta.",
      "seguridad": "Desconecte el equipo antes de retirar la tarjeta."
    },
    "D_MON": {
      "nombre": "Cable o monitor de video",
      "subsistema": "Arranque",
      "accion": "Pruebe otro cable y otro puerto de video, y el monitor con otro equipo. Es la revisión más barata: hágala primero.",
      "seguridad": "Sin riesgos especiales."
    },
    "D_CPU_MB": {
      "nombre": "CPU, placa base o BIOS (el equipo no completa el POST)",
      "subsistema": "Arranque",
      "accion": "Limpie la CMOS (jumper o retirar la pila 30 s), reasiente el procesador y revise pines y ranura; si persiste, pruebe con componentes conocidos.",
      "seguridad": "Desconecte el equipo y use protección antiestática."
    },
    "D_TERM": {
      "nombre": "Sobrecalentamiento (disipador, pasta térmica o ventilación)",
      "subsistema": "Arranque",
      "accion": "Limpie el polvo, verifique que gire el ventilador del CPU, renueve la pasta térmica y confirme que el disipador esté bien montado.",
      "seguridad": "El disipador puede estar muy caliente: espere a que el equipo se enfríe."
    },
    "D_SOFT": {
      "nombre": "Problema de memoria, disco o controladores (falla intermitente)",
      "subsistema": "Arranque",
      "accion": "Ejecute una prueba de memoria (por ejemplo MemTest86), revise el estado SMART del disco y actualice o revierta controladores; anote el código de la pantalla azul.",
      "seguridad": "Respalde su información antes de hacer pruebas con el disco."
    },
    "D_RED_CABLE": {
      "nombre": "Cable de red dañado",
      "subsistema": "Conectividad",
      "accion": "Sustituya el cable o pruébelo con un probador; revise los conectores RJ-45.",
      "seguridad": "Sin riesgos especiales."
    },
    "D_RED_NIC": {
      "nombre": "Puerto o adaptador de red defectuoso (o controlador)",
      "subsistema": "Conectividad",
      "accion": "Pruebe otro puerto del switch o router, reinstale el controlador y, de ser posible, pruebe con un adaptador USB-Ethernet.",
      "seguridad": "Sin riesgos especiales."
    },
    "D_USB": {
      "nombre": "Puertos o controlador USB defectuosos",
      "subsistema": "Conectividad",
      "accion": "Pruebe otros puertos (frontales y traseros), revise los conectores internos y reinicie la configuración de BIOS.",
      "seguridad": "Desconecte el equipo antes de revisar conectores internos."
    }
  },
